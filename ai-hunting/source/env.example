# Sao chép thành .env; biến của process được ưu tiên hơn file này.

# Wazuh Indexer: https://<WAZUH_INDEXER_IP>:9200
INDEXER_HOST=
INDEXER_USER=indexer_agentic
INDEXER_PASS=
INDEXER_INDEX=wazuh-alerts-*

# Wazuh API bổ sung metadata agent, không bắt buộc để tìm alert.
# Endpoint: https://<WAZUH_SERVER_IP>:55000
WAZUH_HOST=
WAZUH_USER=wazuh_agentic
WAZUH_PASS=

# Dùng root CA của Wazuh để xác minh chứng chỉ tự ký.
WAZUH_SSL=true
WAZUH_CA_BUNDLE=
INDEXER_CA_BUNDLE=
# INDEXER_SSL kế thừa WAZUH_SSL nếu không được đặt riêng.
# INDEXER_SSL=true

# Một model đã cài thực hiện cả tool calling và báo cáo.
OLLAMA_HOST=http://127.0.0.1:11434
# Nếu app và Ollama ở hai máy: dùng http://<IP_LAN_MAY_OLLAMA>:11434 tại đây.
# OLLAMA_HOST=0.0.0.0:11434 dùng cho process ollama serve, không dùng làm URL của app.
OLLAMA_MODEL=koga-soc:iq4-xs
# Tạo alias từ model đã tải, giữ nguyên template HF:
# ollama cp hf.co/bartowski/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF:IQ4_XS koga-soc:iq4-xs
# Ollama 0.40.11: create đổi renderer/parser; cp giữ nguyên template HF.
# Có thể dùng trực tiếp tên HF với cùng cấu hình suy luận.
# OLLAMA_MODEL=hf.co/bartowski/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF:IQ4_XS
# Timeout mặc định: 600 giây.
# OLLAMA_TIMEOUT=600
# Context hợp lệ: 4096–65536 token; mặc định 8192.
OLLAMA_NUM_CTX=8192
# Nemotron dùng true/false cho thinking; auto theo mặc định model.
OLLAMA_THINK=false
# Thời gian giữ model trong RAM: số giây hoặc duration như 10m.
OLLAMA_KEEP_ALIVE=10m
# Số alert mỗi trang và mỗi batch phân tích; không giới hạn tổng số alert khớp truy vấn.
OLLAMA_TOOL_BATCH_SIZE=2
# Để trống CPU threads/GPU layers cho Ollama tự chọn.
# num_batch là số token prefill; 1024 đã được đo trên i5-11400H / RTX 2050.
# Máy khác nên để trống cả ba tham số trước khi đánh giá hiệu năng.
OLLAMA_NUM_THREAD=
OLLAMA_NUM_GPU=
OLLAMA_NUM_BATCH=1024
# OLLAMA_NUM_PARALLEL=1 thuộc process Ollama, không có tác dụng nếu chỉ thêm vào .env của app.
# Giới hạn số token đầu ra cho lượt chọn tool và lượt báo cáo.
# OLLAMA_TOOL_TOKENS=768
# OLLAMA_REPORT_TOKENS=2048
# Số lượt model chọn truy vấn; phân trang/đọc chi tiết tự động không tốn các lượt này.
AGENTIC_MAX_STEPS=8
# true đọc hết kết quả khớp từng truy vấn; false chỉ đọc batch đầu.
# Mỗi batch được phân tích riêng để không dồn toàn bộ log vào context của model.
AGENTIC_AUTO_EXPAND=true

# Khoảng tra cứu mặc định (giờ) và timeout Wazuh (giây).
LOOK_BACK_HOURS=24
WAZUH_TIMEOUT=15
# Giao diện bind localhost; dùng tunnel nếu mở từ máy khác.
UI_HOST=127.0.0.1
UI_PORT=8000
